# Copy this file to .env and fill in the key for the provider you use. .env is git-ignored:
# never commit a real key.
#
# Free:  Google AI Studio (Gemini)   https://aistudio.google.com  -> "Get API key"
GEMINI_API_KEY=your-gemini-api-key-here
#
# Other providers (uncomment the one you use):
# GROQ_API_KEY=your-groq-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.example.com/v1     # only for --provider openai with a non-OpenAI endpoint
